{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "DenyCloudTrailChanges",
            "Effect": "Deny",
            "Action": [
                "cloudtrail:StopLogging",
                "cloudtrail:DeleteTrail",
                "cloudtrail:UpdateTrail",
                "cloudtrail:PutEventSelectors"
            ],
            "Resource": "*",
            "Condition": {
                "ArnNotLike": {
                    "aws:PrincipalARN": "arn:aws:iam::*:role/SecurityBreakGlass"
                }
            }
        }
    ]
}
